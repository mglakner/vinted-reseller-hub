# Copy to .env and fill in.

# Login password for the whole app (this is the entire access control — pick a good one).
APP_PASSWORD=change-me

# Secret key for signing session cookies.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Your Vinted marketplace host: www.vinted.co.uk, www.vinted.de, www.vinted.fr,
# www.vinted.com, www.vinted.pl, www.vinted.dk, …
VINTED_DOMAIN=www.vinted.com
# (Your Vinted session cookie is set in the app on the /status page, not here.)

# Currency suffix shown after amounts: kr, €, £, $ …
CURRENCY=€

# --- Product photos (Higgsfield) ---
# 'mcp' = Higgsfield hosted MCP (run `python -m app.higgsfield_mcp login` once). Empty = disabled.
HIGGSFIELD_BACKEND=
# Watermark drawn on shots 01–04, e.g. your @handle. Empty = no watermark.
WATERMARK_TEXT=

# --- Gmail (auto sale detection + weekly report) — optional ---
# Use a Gmail app password (requires 2FA): https://myaccount.google.com/apppasswords
# GMAIL_ADDRESS must be the inbox that receives your Vinted sale emails.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
